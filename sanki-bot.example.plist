<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  One bot as a macOS LaunchAgent: started at login, restarted when it
  exits, running in the background. Copy this file, replace `kitsune` by
  the bot's name and `/Users/you` by your home (launchd expands no `~`),
  then:

      cp sanki-bot.example.plist ~/Library/LaunchAgents/com.sashite.sanki-bot.kitsune.plist
      launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.sashite.sanki-bot.kitsune.plist

  Stop with `launchctl bootout gui/$(id -u)/com.sashite.sanki-bot.kitsune`;
  restart after a change of the configuration with
  `launchctl kickstart -k gui/$(id -u)/com.sashite.sanki-bot.kitsune`.
  One file per bot: another bot is another label, another configuration.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.sashite.sanki-bot.kitsune</string>

	<!-- The configuration and the engine are the two parameters; without
	     the first the built-in bot runs, without the second it plays at
	     random. The bot is the job's process itself, so that launchd's
	     SIGTERM reaches it (a wrapper such as caffeinate would not pass it
	     on); a Mac that must not idle-sleep with a game open is set so in
	     System Settings, Energy. -->
	<key>ProgramArguments</key>
	<array>
		<string>/Users/you/.cargo/bin/sanki-bot</string>
		<string>--config</string>
		<string>/Users/you/sanki/kitsune.toml</string>
		<string>--engine</string>
		<string>/Users/you/.cargo/bin/sanki-sei-random-engine</string>
	</array>

	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>

	<!-- A configuration that is refused exits at once: thirty seconds
	     between restarts keeps the log readable. -->
	<key>ThrottleInterval</key>
	<integer>30</integer>

	<key>StandardOutPath</key>
	<string>/Users/you/Library/Logs/sanki-bot/kitsune.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/you/Library/Logs/sanki-bot/kitsune.log</string>

	<key>EnvironmentVariables</key>
	<dict>
		<key>RUST_LOG</key>
		<string>info</string>
	</dict>

	<!-- No ProcessType: the default scheduling. `Background` would let macOS
	     throttle an engine that budgets its moves in wall-clock time. -->
</dict>
</plist>
